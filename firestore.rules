rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPairId(id) {
      return id is string && id.size() >= 3 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function friendshipPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'RepSouler42@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() <= 200 &&
        data.photoURL is string && data.photoURL.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.lastLoginAt is timestamp;
    }

    function isValidStatsMap(stats) {
      return stats is map &&
        stats.keys().hasAll([
          'drawCount',
          'codeEditCount',
          'voiceCollabs',
          'roomsCreated',
          'pdfOrAiCount',
          'activeMinutes',
          'acceptedInvites'
        ]) &&
        stats.keys().hasOnly([
          'drawCount',
          'codeEditCount',
          'voiceCollabs',
          'roomsCreated',
          'pdfOrAiCount',
          'activeMinutes',
          'acceptedInvites'
        ]) &&
        stats.drawCount is int && stats.drawCount >= 0 && stats.drawCount <= 1000000 &&
        stats.codeEditCount is int && stats.codeEditCount >= 0 && stats.codeEditCount <= 1000000 &&
        stats.voiceCollabs is int && stats.voiceCollabs >= 0 && stats.voiceCollabs <= 1000000 &&
        stats.roomsCreated is int && stats.roomsCreated >= 0 && stats.roomsCreated <= 1000000 &&
        stats.pdfOrAiCount is int && stats.pdfOrAiCount >= 0 && stats.pdfOrAiCount <= 1000000 &&
        stats.activeMinutes is int && stats.activeMinutes >= 0 && stats.activeMinutes <= 1000000 &&
        stats.acceptedInvites is int && stats.acceptedInvites >= 0 && stats.acceptedInvites <= 1000000;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'displayNameLower',
          'friendCode',
          'avatarUrl',
          'color',
          'badges',
          'stats',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'displayNameLower',
          'friendCode',
          'avatarUrl',
          'color',
          'cursorColor',
          'badges',
          'stats',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.displayNameLower is string && data.displayNameLower.size() >= 1 && data.displayNameLower.size() <= 60 &&
        data.friendCode is string && data.friendCode.size() >= 5 && data.friendCode.size() <= 16 && data.friendCode.matches('^CB-[A-Z0-9]{4,8}$') &&
        data.avatarUrl is string && data.avatarUrl.size() <= 350000 &&
        data.color is string && data.color.size() >= 4 && data.color.size() <= 32 &&
        (!('cursorColor' in data) || (data.cursorColor is string && data.cursorColor.size() >= 4 && data.cursorColor.size() <= 32)) &&
        data.badges is list && data.badges.size() <= 20 && (data.badges.size() == 0 || data.badges[0] is string) &&
        isValidStatsMap(data.stats) &&
        data.updatedAt is timestamp;
    }

    function isValidMutedInviter(data, senderId) {
      return data.keys().hasAll(['senderUid', 'senderName', 'mutedUntil', 'createdAt']) &&
        data.keys().hasOnly(['senderUid', 'senderName', 'mutedUntil', 'createdAt']) &&
        data.senderUid is string && data.senderUid == senderId &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
        data.mutedUntil is timestamp &&
        data.createdAt is timestamp;
    }

    function isValidFriendship(data, pairId) {
      return data.keys().hasAll([
          'pairId',
          'participants',
          'requesterId',
          'recipientId',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'pairId',
          'participants',
          'requesterId',
          'recipientId',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.pairId is string && data.pairId == pairId &&
        data.participants is list && data.participants.size() == 2 &&
        data.participants[0] is string && data.participants[1] is string &&
        data.requesterId is string && isValidId(data.requesterId) &&
        data.recipientId is string && isValidId(data.recipientId) &&
        data.requesterId != data.recipientId &&
        data.pairId == friendshipPairId(data.requesterId, data.recipientId) &&
        data.status is string && (data.status == 'pending' || data.status == 'accepted') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRoomInvite(data, inviteId) {
      return data.keys().hasAll([
          'inviteId',
          'fromUid',
          'fromName',
          'fromAvatar',
          'fromColor',
          'toUid',
          'roomId',
          'roomName',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'inviteId',
          'fromUid',
          'fromName',
          'fromAvatar',
          'fromColor',
          'toUid',
          'roomId',
          'roomName',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.inviteId is string && data.inviteId == inviteId &&
        data.fromUid is string && isValidId(data.fromUid) &&
        data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 60 &&
        data.fromAvatar is string && data.fromAvatar.size() <= 350000 &&
        data.fromColor is string && data.fromColor.size() >= 4 && data.fromColor.size() <= 32 &&
        data.toUid is string && isValidId(data.toUid) &&
        data.fromUid != data.toUid &&
        data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 32 && data.roomId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 120 &&
        data.status is string && (
          data.status == 'pending' ||
          data.status == 'accepted' ||
          data.status == 'declined' ||
          data.status == 'muted'
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRoom(data) {
      return data.keys().hasAll([
          'roomId',
          'roomName',
          'ownerId',
          'ownerName',
          'isPublic',
          'isLocked',
          'maxUsers',
          'defaultRole',
          'codeContent',
          'codeLanguage',
          'notesContent',
          'elementsCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomId',
          'roomName',
          'ownerId',
          'ownerName',
          'isPublic',
          'isLocked',
          'maxUsers',
          'defaultRole',
          'codeContent',
          'codeLanguage',
          'notesContent',
          'elementsCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 && data.roomId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 120 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80 &&
        data.isPublic is bool &&
        data.isLocked is bool &&
        data.maxUsers is int && data.maxUsers >= 2 && data.maxUsers <= 30 &&
        data.defaultRole is string && data.defaultRole.size() <= 16 && (data.defaultRole == 'editor' || data.defaultRole == 'viewer') &&
        data.codeContent is string && data.codeContent.size() <= 50000 &&
        data.codeLanguage is string && data.codeLanguage.size() >= 1 && data.codeLanguage.size() <= 32 &&
        data.notesContent is string && data.notesContent.size() <= 50000 &&
        data.elementsCount is int && data.elementsCount >= 0 && data.elementsCount <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCanvasItem(data) {
      return data.keys().hasAll([
          'elementId',
          'roomId',
          'ownerId',
          'type',
          'x',
          'y',
          'width',
          'height',
          'rotation',
          'flipX',
          'flipY',
          'color',
          'fillColor',
          'strokeWidth',
          'text',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'elementId',
          'roomId',
          'ownerId',
          'type',
          'x',
          'y',
          'width',
          'height',
          'rotation',
          'flipX',
          'flipY',
          'color',
          'fillColor',
          'strokeWidth',
          'text',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.elementId is string && data.elementId.size() >= 1 && data.elementId.size() <= 128 && data.elementId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 && data.roomId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.type is string && data.type.size() >= 1 && data.type.size() <= 32 && (
          data.type == 'pencil' ||
          data.type == 'highlighter' ||
          data.type == 'rectangle' ||
          data.type == 'rounded-rect' ||
          data.type == 'circle' ||
          data.type == 'diamond' ||
          data.type == 'triangle' ||
          data.type == 'star' ||
          data.type == 'arrow' ||
          data.type == 'line' ||
          data.type == 'sticky' ||
          data.type == 'text' ||
          data.type == 'image'
        ) &&
        data.x is number &&
        data.y is number &&
        data.width is number &&
        data.height is number &&
        data.rotation is number &&
        data.flipX is bool &&
        data.flipY is bool &&
        data.color is string && data.color.size() >= 1 && data.color.size() <= 32 &&
        data.fillColor is string && data.fillColor.size() >= 1 && data.fillColor.size() <= 32 &&
        data.strokeWidth is number && data.strokeWidth >= 1 && data.strokeWidth <= 64 &&
        data.text is string && data.text.size() <= 2000 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Match Blocks
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin() && resource.data.uid == request.auth.uid;
      allow create: if isAdmin() && isValidId(adminId) && isValidAdminRecord(incoming()) && incoming().uid == adminId && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // PII-free public social profiles searchable by friendCode or displayNameLower
    match /publicProfiles/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId);
      allow list: if isVerifiedUser() && request.query.limit != null && request.query.limit <= 20 && resource.data.uid is string;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidPublicProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidPublicProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().friendCode == existing().friendCode &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Google account private profile (contains email PII — strictly owner-only)
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().lastLoginAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastLoginAt == request.time;
      allow delete: if false;
    }

    // Temporary mute records blocking spam room invites from a specific friend
    match /users/{userId}/mutedInviters/{senderId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isValidId(senderId) && (request.auth.uid == userId || request.auth.uid == senderId);
      allow list: if isVerifiedUser() && request.auth.uid == userId && resource.data.senderUid is string;
      allow create, update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(senderId) &&
        request.auth.uid == userId &&
        senderId != userId &&
        isValidMutedInviter(incoming(), senderId);
      allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(senderId) && request.auth.uid == userId;
    }

    // Bidirectional friend requests & accepted friendships
    match /friendships/{pairId} {
      allow get: if isVerifiedUser() && isValidPairId(pairId) && (resource == null || request.auth.uid in existing().participants);
      allow list: if isVerifiedUser() && request.auth.uid in resource.data.participants;
      allow create: if isVerifiedUser() &&
        isValidPairId(pairId) &&
        isValidFriendship(incoming(), pairId) &&
        incoming().requesterId == request.auth.uid &&
        incoming().status == 'pending' &&
        request.auth.uid in incoming().participants &&
        incoming().recipientId in incoming().participants &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidPairId(pairId) &&
        isValidFriendship(incoming(), pairId) &&
        existing().status == 'pending' &&
        incoming().status == 'accepted' &&
        request.auth.uid == existing().recipientId &&
        incoming().requesterId == existing().requesterId &&
        incoming().recipientId == existing().recipientId &&
        incoming().participants == existing().participants &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidPairId(pairId) && request.auth.uid in existing().participants;
    }

    // Direct real-time room invitations between accepted friends (enforces mute cooldown)
    match /roomInvites/{inviteId} {
      allow get: if isVerifiedUser() && isValidId(inviteId) && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow list: if isVerifiedUser() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(inviteId) &&
        isValidRoomInvite(incoming(), inviteId) &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/friendships/$(friendshipPairId(request.auth.uid, incoming().toUid))) &&
        get(/databases/$(database)/documents/friendships/$(friendshipPairId(request.auth.uid, incoming().toUid))).data.status == 'accepted' &&
        (
          !exists(/databases/$(database)/documents/users/$(incoming().toUid)/mutedInviters/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(incoming().toUid)/mutedInviters/$(request.auth.uid)).data.mutedUntil < request.time
        );
      allow update: if isVerifiedUser() &&
        isValidId(inviteId) &&
        isValidRoomInvite(incoming(), inviteId) &&
        request.auth.uid == existing().toUid &&
        existing().status == 'pending' &&
        (incoming().status == 'accepted' || incoming().status == 'declined' || incoming().status == 'muted') &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().roomId == existing().roomId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(inviteId) && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
    }

    // Saved boards of a Google account (metadata only; the heavy snapshot lives in boardData)
    function isValidBoardMeta(data, boardId) {
      return data.keys().hasAll(['roomId', 'roomName', 'isOwner', 'maxUsers', 'hasSnapshot', 'elementsCount', 'lastOpenedAt']) &&
        data.keys().hasOnly(['roomId', 'roomName', 'isOwner', 'maxUsers', 'hasSnapshot', 'elementsCount', 'lastOpenedAt', 'savedAt', 'skippedMedia']) &&
        data.roomId is string && data.roomId == boardId &&
        data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 120 &&
        data.isOwner is bool &&
        data.maxUsers is int && data.maxUsers >= 2 && data.maxUsers <= 30 &&
        data.hasSnapshot is bool &&
        data.elementsCount is int && data.elementsCount >= 0 && data.elementsCount <= 5000 &&
        data.lastOpenedAt is timestamp &&
        (!('savedAt' in data) || data.savedAt is timestamp) &&
        (!('skippedMedia' in data) || (data.skippedMedia is int && data.skippedMedia >= 0 && data.skippedMedia <= 5000));
    }

    function isValidBoardData(data, boardId) {
      return data.keys().hasAll(['roomId', 'snapshot', 'savedAt']) &&
        data.keys().hasOnly(['roomId', 'snapshot', 'savedAt']) &&
        data.roomId is string && data.roomId == boardId &&
        data.snapshot is string && data.snapshot.size() >= 2 && data.snapshot.size() <= 950000 &&
        data.savedAt is timestamp;
    }

    match /users/{userId}/boards/{boardId} {
      allow read: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
      allow create, update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(boardId) &&
        request.auth.uid == userId &&
        isValidBoardMeta(incoming(), boardId);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    match /users/{userId}/boardData/{boardId} {
      allow get: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(boardId) &&
        request.auth.uid == userId &&
        isValidBoardData(incoming(), boardId);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow get: if isValidId(roomId) && (resource == null || existing().isPublic == true || (isVerifiedUser() && (existing().ownerId == request.auth.uid || isAdmin())));
      allow list: if resource.data.isPublic == true || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);

      allow create: if isVerifiedUser() &&
        isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().roomId == roomId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().roomId == existing().roomId &&
        incoming().ownerId == existing().ownerId &&
        incoming().ownerName == existing().ownerName &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          // Action 1: Owner updates room settings (lock, capacity, default role, title)
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'roomName',
              'isPublic',
              'isLocked',
              'maxUsers',
              'defaultRole',
              'codeContent',
              'codeLanguage',
              'notesContent',
              'elementsCount',
              'updatedAt'
            ])
          ) ||
          // Action 2: Collaborator updates workspace state (code, notes, elementsCount) when room is unlocked and defaultRole is editor
          (
            existing().isLocked == false &&
            existing().defaultRole == 'editor' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'codeContent',
              'codeLanguage',
              'notesContent',
              'elementsCount',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(roomId) && (existing().ownerId == request.auth.uid || isAdmin());

      // Subcollection: Persisted Canvas Elements (Master Gate Pattern)
      match /elements/{elementId} {
        allow get: if isValidId(roomId) && isValidId(elementId) &&
          exists(/databases/$(database)/documents/rooms/$(roomId)) &&
          (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.isPublic == true ||
            (isVerifiedUser() && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid)
          );

        allow list: if resource.data.roomId == roomId;

        allow create: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(elementId) &&
          isValidCanvasItem(incoming()) &&
          incoming().elementId == elementId &&
          incoming().roomId == roomId &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/rooms/$(roomId)) &&
          (
            isAdmin() ||
            get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid ||
            (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.isLocked == false &&
              get(/databases/$(database)/documents/rooms/$(roomId)).data.defaultRole == 'editor'
            )
          );

        allow update: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(elementId) &&
          isValidCanvasItem(incoming()) &&
          incoming().elementId == existing().elementId &&
          incoming().roomId == existing().roomId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/rooms/$(roomId)) && (
            isAdmin() ||
            (
              (
                get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid ||
                (
                  get(/databases/$(database)/documents/rooms/$(roomId)).data.isLocked == false &&
                  get(/databases/$(database)/documents/rooms/$(roomId)).data.defaultRole == 'editor'
                )
              ) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'x',
                'y',
                'width',
                'height',
                'rotation',
                'flipX',
                'flipY',
                'color',
                'fillColor',
                'strokeWidth',
                'text',
                'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(elementId) &&
          exists(/databases/$(database)/documents/rooms/$(roomId)) && (
            isAdmin() ||
            existing().ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid ||
            (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.isLocked == false &&
              get(/databases/$(database)/documents/rooms/$(roomId)).data.defaultRole == 'editor'
            )
          );
      }
    }
  }
}
