{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator record indexed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The UID of the admin user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of admin record creation."
        }
      },
      "required": ["uid", "createdAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Collaborative whiteboard room with canvas elements, code editor state, notes, and access settings.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "description": "Room identifier slug.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomName": {
          "type": "string",
          "description": "Human-readable room title.",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the room creator/owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the room creator.",
          "minLength": 1,
          "maxLength": 80
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether the room is listed and accessible to collaborators."
        },
        "isLocked": {
          "type": "boolean",
          "description": "Whether the room is locked against new edits or joins."
        },
        "maxUsers": {
          "type": "number",
          "description": "Maximum allowed concurrent participants (2 to 30)."
        },
        "defaultRole": {
          "type": "string",
          "description": "Default role assigned to joining participants.",
          "enum": ["editor", "viewer"]
        },
        "codeContent": {
          "type": "string",
          "description": "Synchronized code editor content for this room.",
          "maxLength": 50000
        },
        "codeLanguage": {
          "type": "string",
          "description": "Programming language selected in the room code editor.",
          "minLength": 1,
          "maxLength": 32
        },
        "notesContent": {
          "type": "string",
          "description": "Synchronized markdown notes for this room.",
          "maxLength": 50000
        },
        "elementsCount": {
          "type": "number",
          "description": "Number of canvas elements stored in the room."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "roomId",
        "roomName",
        "ownerId",
        "ownerName",
        "isPublic",
        "isLocked",
        "maxUsers",
        "defaultRole",
        "codeContent",
        "codeLanguage",
        "notesContent",
        "elementsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "CanvasItem": {
      "title": "CanvasItem",
      "description": "Individual whiteboard element persisted inside a room subcollection.",
      "type": "object",
      "properties": {
        "elementId": {
          "type": "string",
          "description": "Unique identifier of the canvas element.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "description": "Parent room ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who created or updated this element.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "description": "Canvas element type.",
          "enum": [
            "pencil",
            "highlighter",
            "rectangle",
            "rounded-rect",
            "circle",
            "diamond",
            "triangle",
            "star",
            "arrow",
            "line",
            "sticky",
            "text",
            "image"
          ]
        },
        "x": {
          "type": "number",
          "description": "X coordinate on canvas."
        },
        "y": {
          "type": "number",
          "description": "Y coordinate on canvas."
        },
        "width": {
          "type": "number",
          "description": "Element width."
        },
        "height": {
          "type": "number",
          "description": "Element height."
        },
        "rotation": {
          "type": "number",
          "description": "Element rotation in degrees."
        },
        "flipX": {
          "type": "boolean",
          "description": "Horizontal mirror state."
        },
        "flipY": {
          "type": "boolean",
          "description": "Vertical mirror state."
        },
        "color": {
          "type": "string",
          "description": "Stroke or text color.",
          "minLength": 1,
          "maxLength": 32
        },
        "fillColor": {
          "type": "string",
          "description": "Fill color.",
          "minLength": 1,
          "maxLength": 32
        },
        "strokeWidth": {
          "type": "number",
          "description": "Stroke thickness."
        },
        "text": {
          "type": "string",
          "description": "Text content for sticky notes, labels, and text elements.",
          "maxLength": 2000
        },
        "createdBy": {
          "type": "string",
          "description": "Author display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "elementId",
        "roomId",
        "ownerId",
        "type",
        "x",
        "y",
        "width",
        "height",
        "rotation",
        "flipX",
        "flipY",
        "color",
        "fillColor",
        "strokeWidth",
        "text",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "PII-free public profile for Google accounts storing display name, friend code, custom avatar (PNG/JPEG/WebP/GIF), cursor color, badges, and activity counters.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Customizable public display name.",
          "minLength": 1,
          "maxLength": 60
        },
        "displayNameLower": {
          "type": "string",
          "description": "Lowercase display name used for prefix search.",
          "minLength": 1,
          "maxLength": 60
        },
        "friendCode": {
          "type": "string",
          "description": "Unique shareable friend tag (e.g. CB-4821).",
          "minLength": 5,
          "maxLength": 16,
          "pattern": "^CB-[A-Z0-9]{4,8}$"
        },
        "avatarUrl": {
          "type": "string",
          "description": "Google avatar URL, optimized PNG/JPEG/WebP/GIF data URL, or chunked avatar marker (chunked:N).",
          "maxLength": 750000
        },
        "color": {
          "type": "string",
          "description": "Selected hex profile and avatar color.",
          "minLength": 4,
          "maxLength": 32
        },
        "cursorColor": {
          "type": "string",
          "description": "Independent hex cursor color used on canvas and code editors.",
          "minLength": 4,
          "maxLength": 32
        },
        "badges": {
          "type": "array",
          "description": "Unlocked achievement badge tokens with tier (e.g. master_sketcher:2, max 24)."
        },
        "stats": {
          "type": "object",
          "description": "Legacy optional activity counters kept only for backward compatibility during migration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "displayNameLower",
        "friendCode",
        "avatarUrl",
        "color",
        "badges",
        "updatedAt"
      ]
    },
    "AvatarChunk": {
      "title": "AvatarChunk",
      "description": "Chunked animated GIF data URL segment for 1 MB profile avatars stored under publicProfiles/{userId}/avatarChunks/{chunkIndex}.",
      "type": "object",
      "properties": {
        "chunkIndex": {
          "type": "string",
          "description": "Zero-based chunk index string (0 to 3).",
          "enum": ["0", "1", "2", "3"]
        },
        "data": {
          "type": "string",
          "description": "Base64 data URL segment.",
          "minLength": 1,
          "maxLength": 450000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["chunkIndex", "data", "updatedAt"]
    },
    "PrivateBadgeStats": {
      "title": "PrivateBadgeStats",
      "description": "Owner-only private activity counters driving 4-tier badge progression (Bronze, Silver, Gold, Diamond).",
      "type": "object",
      "properties": {
        "drawCount": {
          "type": "number",
          "description": "Total drawings, shapes, or notes created."
        },
        "codeEditCount": {
          "type": "number",
          "description": "Total meaningful collaborative code contributions."
        },
        "voiceCollabs": {
          "type": "number",
          "description": "Total multi-participant voice sessions joined."
        },
        "roomsCreated": {
          "type": "number",
          "description": "Total study/work rooms created."
        },
        "pdfOrAiCount": {
          "type": "number",
          "description": "Total PDF, template, or AI drawing uses."
        },
        "activeMinutes": {
          "type": "number",
          "description": "Total active minutes spent inside workspaces."
        },
        "acceptedInvites": {
          "type": "number",
          "description": "Total friend room invitations accepted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "drawCount",
        "codeEditCount",
        "voiceCollabs",
        "roomsCreated",
        "pdfOrAiCount",
        "activeMinutes",
        "acceptedInvites",
        "updatedAt"
      ]
    },
    "MutedInviter": {
      "title": "MutedInviter",
      "description": "Temporary mute record blocking a specific friend from sending room invitations until mutedUntil.",
      "type": "object",
      "properties": {
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "mutedUntil": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderUid", "senderName", "mutedUntil", "createdAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Bidirectional friend request and accepted friendship record keyed by deterministic pairId.",
      "type": "object",
      "properties": {
        "pairId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participants": {
          "type": "array",
          "description": "Exactly two UIDs participating in this friendship."
        },
        "requesterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "pairId",
        "participants",
        "requesterId",
        "recipientId",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomInvite": {
      "title": "RoomInvite",
      "description": "Direct real-time room invitation sent from one accepted friend to another.",
      "type": "object",
      "properties": {
        "inviteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "fromAvatar": {
          "type": "string",
          "maxLength": 350000
        },
        "fromColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "toUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined", "muted"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inviteId",
        "fromUid",
        "fromName",
        "fromAvatar",
        "fromColor",
        "toUid",
        "roomId",
        "roomName",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Trusted admin lookup records."
    },
    "/publicProfiles/{userId}": {
      "schema": "PublicProfile",
      "description": "PII-free social profile directory searchable by friendCode or displayName."
    },
    "/publicProfiles/{userId}/avatarChunks/{chunkIndex}": {
      "schema": "AvatarChunk",
      "description": "Publicly readable, owner-writable chunks for animated GIF avatars up to 1 MB."
    },
    "/users/{userId}/private/{docId}": {
      "schema": "PrivateBadgeStats",
      "description": "Owner-only private badge progress counters (docId = badgeStats)."
    },
    "/users/{userId}/mutedInviters/{senderId}": {
      "schema": "MutedInviter",
      "description": "Temporary mute records preventing a friend from sending room invitations until expiration."
    },
    "/friendships/{pairId}": {
      "schema": "Friendship",
      "description": "Two-way friend requests and accepted friendships."
    },
    "/roomInvites/{inviteId}": {
      "schema": "RoomInvite",
      "description": "Direct real-time room invitations between accepted friends."
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Collaborative rooms storing room settings, code editor state, and shared notes."
    },
    "/rooms/{roomId}/elements/{elementId}": {
      "schema": "CanvasItem",
      "description": "Persisted canvas elements belonging to a specific room."
    }
  }
}
